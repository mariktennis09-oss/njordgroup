# Скопировать в .env.local и заполнить. Все переменные необязательны —
# без них сайт работает, просто соответствующая функция выключена.

# Номер счётчика Яндекс.Метрики. Пока пусто — счётчик не подключается,
# на страницу не попадает ни одного байта аналитики.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Куда форма отправляет заявку. По умолчанию — собственный роут /api/lead
# (нужен Node-хостинг). При статическом экспорте указать сюда внешний
# endpoint, формы менять не потребуется.
NEXT_PUBLIC_LEAD_ENDPOINT=
